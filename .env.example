# JARVIS AI - Environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file or real API keys to source control.

# ------------------------------------------------------------------
# AI PROVIDER (Phase 2)
# ------------------------------------------------------------------
# Choose which AI provider to use:
#   "auto" (recommended) | "openai" | "google" | "groq" | "huggingface"
#   | "anthropic" | "local"
#
# "auto" chains every FREE provider below that has a key. If the first
# is rate-limited, the next one is tried automatically - so you should
# rarely see a "rate limit" error again.
AI_PROVIDER=auto

# --- OpenRouter (free models, key prefix sk-or-v1-) ----------------------
# Sign up at https://openrouter.ai (free), create a key, add it below.
# No credits are needed - these ":free" models work with an empty balance.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3.5-lightning:free

# Free OpenRouter models to rotate through when AI_PROVIDER=auto.
# They all follow JARVIS's TOOL protocol and cost nothing.
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free

# --- Google Gemini (free tier) -------------------------------------------
# Get a key at https://aistudio.google.com/apikey (free, very generous).
# No credit card required. Google also supports native tool calling.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest

# --- Groq (free tier) ----------------------------------------------------
# Get a key at https://console.groq.com/keys (free, extremely fast).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- HuggingFace community router (free) ---------------------------------
# Get a token at https://huggingface.co/settings/tokens (free tier).
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- OpenAI / Anthropic (paid, optional) ---------------------------------
# For a normal OpenAI key (not OpenRouter) leave OPENAI_BASE_URL empty
# and set OPENAI_MODEL above to an OpenAI model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Tools (Phase 6): let the AI call built-in tools (clock, calculator).
# TOOL_MAX_ITERATIONS caps the agent loop so a misbehaving model cannot
# chain tool calls forever.
TOOLS_ENABLED=true
TOOL_MAX_ITERATIONS=4

# Permissions (Phase 25): when true, JARVIS runs sensitive tools (files,
# apps, URLs, screenshots, patches) without asking for approval first and
# drops the ask-permission rules from its instructions. You can also toggle
# this live from Settings (it is saved between sessions). Default: false.
UNRESTRICTED_MODE=false

# Local / offline mode (see README for setup)
LOCAL_MODEL_PATH=

# Local LLM (Phase 25): point JARVIS at an OpenAI-compatible server you run
# yourself (Ollama, LM Studio, llama.cpp). No API key and no internet needed;
# the model you pick decides what it answers. To use it set:
#   AI_PROVIDER=localllm  (with the two settings below)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# ------------------------------------------------------------------
# VOICE (Phases 3-5)
# ------------------------------------------------------------------
# Text-to-speech engine: "system" (uses built-in Windows voices)
TTS_ENGINE=system
TTS_VOICE=
TTS_SPEED=180
TTS_ENABLED=true

# Speech-to-text provider: "google" (free) | "openai" | "whisper" (local)
STT_PROVIDER=google
# Recognition language (Phase 30): an IETF tag like "en-US", "fr-FR",
# "es-ES", "de-DE", "it-IT", "pt-BR", "ja-JP"... Google auto-detects when
# empty; Whisper prefers an uncapitalised full name like "english".
STT_LANGUAGE=en-US

# Tone-of-voice emotion detection (Phase 29): when true, JARVIS analyses
# the sound of spoken audio to estimate happy / sad / angry / neutral and
# responds with appropriate empathy. Local and free (numpy only); it never
# uploads audio and reports "neutral" when it is unsure.
TONE_EMOTION_ENABLED=true

# Mood-adapted voice (Phase 30): when true, spoken replies are slowed for
# a "sad" tone hint and brightened for "happy" so the voice matches mood.
TTS_MOOD_EMPHASIS=true

# Push-to-talk (Phase 30): hold a global hotkey to talk instead of clicking
# the mic button. Requires the optional 'keyboard' library:
#     pip install keyboard
# The hotkey uses `keyboard`'s syntax, e.g. "ctrl+space", "alt+q", "f9".
PTT_ENABLED=false
PTT_HOTKEY=ctrl+space

# Wake word (Phase 5) - the phrase that makes JARVIS listen.
# Default OFF so the microphone is never used without your consent.
WAKE_WORD=hey jarvis
WAKE_WORD_ENABLED=false

# ------------------------------------------------------------------
# LOCAL DOCUMENT MEMORY - RAG (Phase 30)
# ------------------------------------------------------------------
# JARVIS can index a folder of documents and answer questions from them.
# Ask "index the folder <path>" and then query it. Index location defaults
# to <data_dir>/rag_index; override with RAG_INDEX_DIR.

# ------------------------------------------------------------------
# PLUGINS (Phase 30)
# ------------------------------------------------------------------
# Third-party tools: drop a .py file that subclasses PluginTool into the
# project 'plugins/' folder (or a folder named here) and JARVIS loads it
# at startup, no code changes needed.
PLUGINS_DIR=

# ------------------------------------------------------------------
# WEB SEARCH (Phase 10)
# ------------------------------------------------------------------
# If empty, web search features will report that they are not configured.
# You can use Tavily: https://tavily.com  (free tier available)
TAVILY_API_KEY=

# Weather
OPENWEATHERMAP_API_KEY=

# ------------------------------------------------------------------
# MISC
# ------------------------------------------------------------------
# Application data folder (defaults to a folder inside the project)
JARVIS_DATA_DIR=

# Assistant display name
ASSISTANT_NAME=JARVIS

# ------------------------------------------------------------------
# SELF-UPDATE (Phase 21)
# ------------------------------------------------------------------
# HTTPS URL of a JSON manifest advertising newer builds, e.g.:
#     UPDATE_MANIFEST_URL=https://example.com/jarvis-updates.json
# The manifest looks like:
#     {"version": "1.1.0", "url": "https://example.com/JARVIS AI.exe",
#      "sha256": "<hex sha-256 of the exe>", "notes": "What changed"}
# Leave empty to disable update checks.
UPDATE_MANIFEST_URL=

# ------------------------------------------------------------------
# SECURITY MONITORING (Phase 28)
# ------------------------------------------------------------------
# Background threat scan interval in seconds. Minimum enforced: 5.
# Default: 60 (scan the machine every minute).
THREAT_SCAN_INTERVAL=60

# ------------------------------------------------------------------
# EMAIL ASSISTANT (Phase 30)
# ------------------------------------------------------------------
# Optional. When configured, JARVIS can check/read/send email (IMAP + SMTP).
# Set all four for full support; smtp may be empty for read-only.
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
EMAIL_MAX_RESULTS=10

# ------------------------------------------------------------------
# FOCUS-AWARE RECAP (Phase 30)
# ------------------------------------------------------------------
# When you have been away from the keyboard for a while, JARVIS nudges you
# back into focus with a short recap. Windows-only idle detection.
FOCUS_RECAP_ENABLED=false
FOCUS_RECAP_IDLE_MINUTES=15

# ------------------------------------------------------------------
# FOLDER WATCHER (Phase 30)
# ------------------------------------------------------------------
# Watch a folder and surface new/changed files in chat. Set to an absolute
# path to enable. WATCH_INDEX_CHANGES also feeds them into the local RAG
# index automatically.
WATCH_FOLDER=
WATCH_INDEX_CHANGES=false

# ------------------------------------------------------------------
# CONVERSATION SUMMARIES (Phase 30)
# ------------------------------------------------------------------
# Long chats get old turns compressed into a summary so context survives
# past the model's window.
SUMMARY_ENABLED=true
SUMMARY_THRESHOLD=24

# ------------------------------------------------------------------
# MORNING BRIEFING (Phase 30)
# ------------------------------------------------------------------
# Greet the user with the time, weather, reminders and mood read on startup.
BRIEFING_ON_START=false

# ------------------------------------------------------------------
# CAMERA FALL DETECTION (Phase 31)
# ------------------------------------------------------------------
# Always-on camera + pose-based fall detection. When a fall is detected a
# countdown starts; unless the user cancels, an alert message plus a call
# go out to the emergency contact. Set the contact details to enable alerts.
CAMERA_FALL_ENABLED=true
# Which webcam to use (0 = first camera).
CAMERA_FALL_INDEX=0
# Emergency contact for fall alerts: at least one must be set to get help.
FALL_EMERGENCY_NUMBER=+15551234567
FALL_EMERGENCY_EMAIL=
FALL_ALERT_MESSAGE=HELP - I have fallen and cannot get up.
# Seconds given to cancel a false alarm before help is alerted.
FALL_COUNTDOWN_SECONDS=15

# ------------------------------------------------------------------
# ATTACHMENTS - UPLOAD & PASTE (Phase 32)
# ------------------------------------------------------------------
# Where uploaded/pasted images and documents are kept before analysis.
# Defaults to <data_dir>/uploads. Images need a GOOGLE_API_KEY to be
# analysed (vision); documents are read locally with read_document.
UPLOADS_DIR=

# ------------------------------------------------------------------
# SMART GLASSES / WEARABLES (Phase 33)
# ------------------------------------------------------------------
# Universal Bluetooth link: JARVIS can scan for paired devices, select
# the glasses, and deliver notifications (native toast + spoken aloud on
# audio-capable glasses). It cannot embed itself into the hardware.
GLASSES_ENABLED=true
# Name fragment to auto-select (e.g. "Ray-Ban", "XREAL"). Empty = first
# glasses-like device found.
GLASSES_DEVICE=
# When true, every JARVIS reply is also pushed to the glasses.
GLASSES_MIRROR_REPLIES=false
